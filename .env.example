# Supabase Configuration (Optional if you use the built-in project)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Emails (Optional, comma-separated)
# First authenticated user or users in this list can elevate to admin
VITE_ADMIN_EMAILS=admin@example.com,another@example.com

# Local OpenAI teaser generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5
